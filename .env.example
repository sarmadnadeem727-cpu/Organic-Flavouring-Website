# Organic Flavouring - Environment Variables Template
# Copy this file to .env and provide your specific credentials

# Store & Contact Settings
VITE_SITE_URL="https://organicflavouring.com"
VITE_WHATSAPP_NUMBER="923000000000"
VITE_SUPPORT_EMAIL="organicflavouring@gmail.com"

# EmailJS Configuration (Used for order notifications)
VITE_EMAILJS_PUBLIC_KEY="your_public_key_here"
VITE_EMAILJS_SERVICE_ID="your_service_id_here"
VITE_EMAILJS_ADMIN_TEMPLATE_ID="your_admin_template_id_here"
VITE_EMAILJS_CUSTOMER_TEMPLATE_ID="your_customer_template_id_here"

# Order Storage (Google Sheets Webhook / Apps Script)
VITE_GOOGLE_SHEETS_WEBHOOK_URL="your_apps_script_url_here"

# Ad Pixels & Analytics (Optional: left empty disables platform silently)
VITE_META_PIXEL_ID=""
VITE_GA4_ID=""
VITE_TIKTOK_PIXEL_ID=""
